---
import heyImage from "@/assets/img/stickers/hey.png";
import {
  getLangFromUrl,
  useTranslatedPath,
  useTranslations,
} from "@/i18n/utils";
import { getProjectsWithTechnologies } from "@/lib/cruds/project";
import { Image } from "astro:assets";
import ProjectCard from "./ProjectCard.svelte";
import ProjectCardLinks from "./ProjectCardLinks.astro";

const lang = getLangFromUrl(Astro.url);
const projects = await getProjectsWithTechnologies(lang);

const translatePath = useTranslatedPath(lang);
const t = useTranslations(lang);
---

<section id="projects" aria-labelledby="projects-title" class="relative">
  <h2 id="projects-title" class="sr-only">
    {t("projects.title")}
  </h2>
  <div class="-z-10 min-h-[calc(100vh-50vh)] min-w-[calc(100vw-50vw)] max-w-[780px] max-h-[780px] w-full h-full md:min-h-[780px] md:min-w-[780px] rounded-full absolute top-0 gradient-experience__1 blur-[150px] -translate-y-1/4 -translate-x-1/2 left-1/2"></div>

  <div class="-z-20 w-full h-full max-w-[394px] max-h-[560px] gradient-experience__2 absolute top-0 -translate-x-1/2 left-1/2 opacity-100 blur-[150px] translate-y-2/3 lg:translate-y-1/3"></div>

  <div
    class={
      "relative max-w-5xl mx-auto px-8 grid grid-cols-1 md:grid-cols-2 gap-10"
    }
  >
    <div class="-z-10 absolute top-8 left-1 select-none pointer-events-none -translate-y-full">
      <Image
        src={heyImage}
        alt=""
        class={"object-contain ml-3 md:ml-12 w-auto h-28 md:h-36"}
        height={184}
      />
    </div>
    {projects.map((project) => {
      const href = translatePath(`/projects/${project.id}/`);
      return (
        <ProjectCard
          {project}
          {href}
          caseLabel={t("projects.viewCase")}
          client:load
        >
          <ProjectCardLinks {project} newTabLabel={t("links.newTab")} />
        </ProjectCard>
      );
    })}
  </div>
</section>
