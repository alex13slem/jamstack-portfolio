---
import { cn } from "@/lib/utils/styles";
import { getLangFromUrl, useTranslations } from "@/i18n/utils";
import Icon from "astro-iconify";

interface Props {
  href: string;
  projectName: string;
  class?: string;
}

const { href, projectName, class: className } = Astro.props;
const t = useTranslations(getLangFromUrl(Astro.url));
const label = `${t("projects.openSource")}: ${projectName} (${t("links.newTab")})`;
---

<a
  {href}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={label}
  title={label}
  class={cn(
    `rounded-xl p-4 bg-white/5 backdrop-blur-sm border border-white/10
    flex self-start justify-center items-center text-white/60 hover:text-white
    transition-colors`,
    className
  )}
>
  <Icon name="octicon:logo-github-16" class="h-5" aria-hidden="true" />
</a>
