---
import type { ProjectWithTechs } from "@/lib/cruds/project";
import { cn } from "@/lib/utils/styles";
import { getLangFromUrl, useTranslations } from "@/i18n/utils";

interface Props {
  project: ProjectWithTechs;
  class?: string;
}

const { project, class: className } = Astro.props;
const { name, image_cover, site_url } = project;
const t = useTranslations(getLangFromUrl(Astro.url));
---

<section
  class={cn(
    `project-thumbnail p-[2px] overflow-clip z-10
            rounded-xl animate-gradient__rotate animate-gradient__activeXs
            relative group aspect-[4/3] w-full min-h-0 shrink-0 self-start`,
    className,
  )}
>
  {site_url && (
    <>
      <a
        class="project-thumbnail__link absolute inset-0 z-10 flex items-end justify-end p-4 rounded-xl"
        href={site_url}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`${t("projects.openSite")}: ${name} (${t("links.newTab")})`}
      >
        <span class="rounded-full bg-bg px-4 py-2 text-white text-sm font-semibold border border-white/30">
          {t("projects.openSite")}
        </span>
      </a>
      <i aria-hidden="true"></i>
    </>
  )}
  <div
    class={cn(`bg-white/5 backdrop-blur-sm
                rounded-[10px] border border-white/10
                overflow-clip z-10 h-full`)}
  >
    <img
      src={image_cover}
      alt={name}
      width={800}
      height={600}
      fetchpriority="high"
      class="bg-white/10 w-full h-full object-cover"
    />
  </div>
</section>
