---
import { getLangFromUrl, useTranslations } from "@/i18n/utils";
import type { Tech } from "@/lib/schemas/tech";
import Icon from "astro-iconify";
interface Props {
  techs: Tech[];
}
const { techs } = Astro.props;
const t = useTranslations(getLangFromUrl(Astro.url));
---

{techs.length > 0 && (
  <section class="p-4 rounded-xl bg-white/5 backdrop-blur-sm border border-white/10">
    <h2 class="white_gradient font-extrabold bg-clip-text text-transparent text-sm uppercase leading-snug text-balance">
      {t("projects.techs.title")}
    </h2>
    <ul role="list" class="case-techs">
      {techs.map((tech) => (
        <li>
          <a href={tech.url} class="case-tech" translate="no">
            <Icon
              name={tech.iconify_id}
              width="20"
              height="20"
              aria-hidden="true"
            />
            <span>{tech.name}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>
)}

<style>
  .case-techs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.875rem;
    margin-top: 0.75rem;
  }
  .case-tech {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    min-height: 32px;
    max-width: 100%;
    color: #c8c8c3;
    font-size: 0.875rem;
    transition: color 0.2s;
  }
  .case-tech:hover {
    color: #fff;
  }
  .case-tech :global(svg) {
    flex-shrink: 0;
  }
</style>
