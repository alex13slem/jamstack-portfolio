---
import "@/assets/fonts/shadows-into-light-font.css";
import { getLangFromUrl, useTranslations } from "@/i18n/utils";
import { cn } from "@/lib/utils/styles";
import "@/styles/global.css";
import "@fontsource/source-sans-3/200.css";
import "@fontsource/source-sans-3/300.css";
import "@fontsource/source-sans-3/400.css";
import "@fontsource/source-sans-3/500.css";
import "@fontsource/source-sans-3/600.css";
import "@fontsource/source-sans-3/700.css";
import "@fontsource/source-sans-3/800.css";
import "@fontsource/source-sans-3/900.css";
import { ClientRouter } from "astro:transitions";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import MotionToggle from "../components/MotionToggle.astro";

interface Props {
  class?: string;
  languageFallback?: string;
}
const { class: className, languageFallback } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<!doctype html>
<html class="dark" {lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="referrer" content="origin" />
    <meta name="theme-color" content="#090f16" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <slot name="head" />

    <ClientRouter />
  </head>
  <body
    class={cn(
      `relative
      bg-bg
      z-0
      min-h-svh
      tracking-wide
      text-white`,
      className,
    )}
  >
    <a href="#main-content" class="skip-link">
      {t("a11y.skipContent")}
    </a>
    <MotionToggle />
    <div class="fixed inset-0 -z-10 pointer-events-none opacity-90 bg-noise"></div>
    <Header {languageFallback} />
    <slot />
    <Footer />
  </body>
</html>
